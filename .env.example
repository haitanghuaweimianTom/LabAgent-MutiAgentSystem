# 数学建模多Agent系统 - 环境变量配置示例
# 请根据你的 Provider 配置修改以下变量

# 通用 API 配置（兼容旧 MINIMAX_API_KEY）
API_KEY=your_api_key_here

# ===== MiniMax-M3 Provider (推荐, 默认) =====
# 推理相关 Agent 512K，其余 500K，自动压缩 90%
MINIMAX_API_KEY=your_minimax_key_here
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TIMEOUT=120

# 全局上下文长度（tokens），大部分 Agent 用此值
LLM_MAX_CONTEXT_LENGTH=500000

# 自动压缩阈值比例（0-1，默认 0.9 = 90%）
# 触发条件：累计 token >= max_context_length × ratio
LLM_AUTO_COMPRESS_RATIO=0.9

# 推理相关 Agent 的上下文长度（orchestrator / 建模 / 写作 / 代码生成）
LLM_REASONING_CONTEXT_LENGTH=512000

# ===== 其他 Provider 示例（取消注释并填写即可使用）=====
# ANTHROPIC_API_KEY=your_anthropic_key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OPENAI_API_KEY=your_openai_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-2.5-pro

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:latest

# 默认 LLM Provider（留空则自动检测；优先 MiniMax）
DEFAULT_LLM_PROVIDER=minimax

# API 基础地址（兼容旧版，新代码用 MINIMAX_*）
API_BASE_URL=https://api.minimaxi.com

# 默认模型配置（兼容旧版，新代码用 MINIMAX_MODEL）
DEFAULT_MODEL=MiniMax-M3
FALLBACK_MODEL=MiniMax-M3

# 应用配置
DEBUG=false
APP_NAME=数学建模多Agent系统
APP_VERSION=8.5.0

# CORS配置（逗号分隔或 JSON 数组；生产环境收紧为具体域名）
# 本地开发建议放开为 *：前端端口/访问方式不固定（localhost/127.0.0.1/局域网IP + 3000~3002），
# 写死端口列表会漏导致前端拉不到任务/数据。allow_credentials=False 时 * 安全。
CORS_ORIGINS=*

# 数据库配置
DATABASE_URL=sqlite:///./data/agents.db

# Redis配置（可选）
REDIS_URL=redis://localhost:6379

# MCP服务器配置
MCP_SERVERS_PATH=./config/mcp_config.json

# 输出目录
OUTPUT_DIR=./output


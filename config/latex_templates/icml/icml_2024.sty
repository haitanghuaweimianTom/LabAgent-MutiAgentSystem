% Minimal ICML 2024 style file
% Based on the official ICML LaTeX style (simplified for distribution).
% Provides letterpaper, 10pt, single-column layout with anonymous author block.
% Replace with the official icml_2024.sty before submission.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml_2024}[2024/01/01 ICML 2024 Style]

\RequirePackage{geometry}
\geometry{
  letterpaper,
  left=1in,
  right=1in,
  top=1in,
  bottom=1in
}

\RequirePackage{fancyhdr}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% 10pt base font, single column
\renewcommand{\normalsize}{\@setfontsize\normalsize{10}{12}}

% Anonymous author block
\newcommand{\icmlauthor}[1]{%
  \gdef\@icmlauthor{#1}%
}
\def\@icmlauthor{Anonymous Author(s)\\Anonymous Institution\\\texttt{anon@anonymous.edu}}

\renewcommand{\maketitle}{%
  \par
  \begingroup
    \centering
    {\LARGE\bfseries \@title \par}
    \vspace{1.5em}
    {\normalsize \@icmlauthor \par}
    \vspace{1em}
  \endgroup
}
\endinput

% Minimal ICLR 2024 style file
% Based on the official ICLR LaTeX style (simplified for distribution).
% Provides letterpaper, 11pt, single-column layout with anonymous author block.
% Replace with the official iclr2024_conference.sty from OpenReview before submission.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iclr2024_conference}[2024/01/01 ICLR 2024 Conference Style]

\RequirePackage{geometry}
\geometry{
  letterpaper,
  left=1in,
  right=1in,
  top=1in,
  bottom=1in
}

\RequirePackage{fancyhdr}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% 11pt base font, single column
\renewcommand{\normalsize}{\@setfontsize\normalsize{11}{13.6}}

% Anonymous author block
\newcommand{\iclrauthor}[1]{%
  \gdef\@icltrauthor{#1}%
}
\def\@icltrauthor{Anonymous Author(s)\\Anonymous Institution\\\texttt{anon@anonymous.edu}}

\renewcommand{\maketitle}{%
  \par
  \begingroup
    \centering
    {\LARGE\bfseries \@title \par}
    \vspace{1.5em}
    {\normalsize \@icltrauthor \par}
    \vspace{1em}
  \endgroup
}
\@ifclassloaded{article}{}{}
\endinput
